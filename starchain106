;==================================================
; 规则集 (高优先级，从上往下匹配)
;==================================================
; 强制将 Switch 设备的所有流量直接送入游戏专线，无视任何规则限制
ruleset=🎮 Nintendo,[]SRC-IP-CIDR,192.168.1.200/32

; 基础本地与直连放行
ruleset=🎯 全球直连,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/LocalAreaNetwork.list
